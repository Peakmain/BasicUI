<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cookie"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_toast_tips"
    android:paddingHorizontal="@dimen/dimen_24"
    android:paddingTop="@dimen/dimen_72"
    android:paddingBottom="@dimen/dimen_16">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <TextView
        android:id="@+id/btn_action"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/font_size_14"
        tools:text="提示：所有距离信息均为直线距离所有距离信息均为直线距离所有距离信息均为直线距离所有距离信息均为直线距离所有距离信息均为直线距离所有距离信息均为直线距离所有距离信息均为直线距离" />
</RelativeLayout>